@@ -3590,6 +3597,47 @@ async function computeInvoiceAuditFlags(invoice, precomputedOrderMap = null) {
     }
   }
 
+  // 2b. Same-service duplicate check within this invoice. The orderId-based
+  // check above only catches line items that share an explicit clinical
+  // order ID; a service billed twice on one invoice via two separate manual
+  // line items (no shared order ID) would otherwise go undetected entirely.
+  const seenByService = new Map();
+  for (const item of lineItems) {
+    const orderId = item.orderId || item.id;
+    if (flaggedOrderIds.has(orderId)) continue; // already flagged above
+    const key = item.masterServiceId != null ? `msd:${item.masterServiceId}` : `text:${(item.serviceType || '').toLowerCase()}`;
+    if (!seenByService.has(key)) seenByService.set(key, []);
+    seenByService.get(key).push(item);
+  }
+  for (const [, group] of seenByService) {
+    if (group.length > 1) {
+      const totalAmt = group.reduce((sum, g) => sum + Number(g.amount || 0), 0);
+      const criticalThreshold = SETTINGS_STATE.compliance?.duplicateCriticalThreshold || 50000;
+      const severity = totalAmt >= criticalThreshold ? 'critical' : 'warning';
+      const serviceName = group[0].catalogueServiceName || group[0].serviceType;
+      flags.push({
+        code: 'duplicate_charge',
+        name: 'Duplicate charge',
+        severity,
+        lineItemId: group[0].id,
+        message: `"${serviceName}" appears ${group.length} times on this invoice.`,
+        billedAmount: totalAmt,
+        matchingRecord: {
+          source: 'line_item',
+          id: group[0].id,
+          label: `Same service billed ${group.length} times on this invoice`,
+          details: {
+            type: 'line_item',
+            serviceType: serviceName,
+            occurrences: group.length,
+            amount: totalAmt,
+          }
+        }
+      });
+      for (const g of group) flaggedOrderIds.add(g.orderId || g.id);
+    }
+  }
+
   // 3 & 4. Payer plan rule checks (pre-auth threshold, copay percentage)
   const payerType = invoice.payer_type || invoice.payerType;
   const payerName = invoice.payer_name || invoice.payerName;
@@ -3884,6 +3932,26 @@ app.get('/api/compliance/summary', requireAuth, async (req, res) => {
     // Build the cross-invoice order map once so duplicate check runs efficiently in O(N)
